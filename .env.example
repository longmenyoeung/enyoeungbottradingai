# Optional Telegram Alerts Configuration
# Create a bot via @BotFather on Telegram to get your token
# Get your Chat ID via @userinfobot or channel ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Forex (FX) Data Provider — free tier
# Register at https://twelvedata.com to get a free API key (800 requests/day, 8 req/min).
# Leave empty to run Forex mode entirely on the keyless Yahoo Finance fallback.
TWELVE_DATA_API_KEY=

# Optional: tune the Twelve Data free-tier guard rails (defaults shown)
# TWELVE_DATA_MAX_RPM=8
# TWELVE_DATA_MAX_DAILY=800
# FOREX_SYMBOL_ENRICH_LIMIT=12
